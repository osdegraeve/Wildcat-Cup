/* ===========================================
   WILDCAT CUP
   Global Styles
=========================================== */

:root{

    --green:#0B3D2E;
    --green-light:#1D5A46;
    --gold:#C8A45B;
    --cream:#F8F6F1;
    --white:#ffffff;
    --black:#111111;
    --gray:#6B6B6B;

    --shadow:0 15px 40px rgba(0,0,0,.15);

}

*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}

html{

    scroll-behavior:smooth;

}

body{

    background:var(--cream);

    color:var(--black);

    font-family:'Inter',sans-serif;

    overflow-x:hidden;

}

/* ===========================================
Typography
=========================================== */

h1,h2,h3,h4,h5{

    font-family:'Cormorant Garamond',serif;

    font-weight:700;

}

p{

    color:#444;

    line-height:1.8;

    font-size:18px;

}

.section-tag{

    letter-spacing:3px;

    text-transform:uppercase;

    color:var(--gold);

    font-size:14px;

    font-weight:600;

}

section{

    padding:120px 0;

}

/* ===========================================
Navigation
=========================================== */

.navbar{

    background:rgba(11,61,46,.88);

    backdrop-filter:blur(16px);

    transition:.4s;

    padding:20px 0;

}

.navbar.scrolled{

    background:rgba(11,61,46,.98);

    box-shadow:0 8px 25px rgba(0,0,0,.3);

}

.logo{

    width:48px;

    margin-right:10px;

}

.navbar-brand{

    display:flex;

    align-items:center;

    color:white!important;

    font-size:32px;

    font-family:'Cormorant Garamond',serif;

}

.nav-link{

    color:white!important;

    margin-left:20px;

    font-weight:500;

    position:relative;

}

.nav-link::after{

    content:"";

    position:absolute;

    bottom:-8px;

    left:0;

    width:0;

    height:2px;

    background:var(--gold);

    transition:.3s;

}

.nav-link:hover::after{

    width:100%;

}

/* ===========================================
Hero
=========================================== */

.hero{

    position:relative;

    height:100vh;

    overflow:hidden;

    display:flex;

    align-items:center;

    justify-content:center;

}

.hero video{

    position:absolute;

    inset:0;

    width:100%;

    height:100%;

    object-fit:cover;

}

.hero-overlay{

    position:absolute;

    inset:0;

    background:linear-gradient(

        rgba(0,0,0,.55),

        rgba(0,0,0,.45)

    );

}

.hero-content{

    position:relative;

    z-index:3;

    text-align:center;

    color:white;

}

.hero-content h1{

    font-size:110px;

    margin-bottom:10px;

}

.hero-content h2{

    font-size:46px;

    color:var(--gold);

}

.subtitle{

    font-size:22px;

    margin-top:20px;

    color:white;

}

.eyebrow{

    letter-spacing:4px;

    text-transform:uppercase;

    color:var(--gold);

    font-size:15px;

}

/* ===========================================
Buttons
=========================================== */

.hero-buttons{

    display:flex;

    justify-content:center;

    gap:20px;

    margin-top:50px;

    flex-wrap:wrap;

}

.btn-course{

    background:var(--green);

    color:white;

    padding:18px 42px;

    border-radius:40px;

    transition:.35s;

}

.btn-course:hover{

    transform:translateY(-4px);

    background:var(--green-light);

    color:white;

}

.btn-gold{

    background:var(--gold);

    color:black;

    padding:18px 42px;

    border-radius:40px;

    transition:.35s;

}

.btn-gold:hover{

    transform:translateY(-4px);

    color:black;

    filter:brightness(1.05);

}

/* ===========================================
Hero Statistics
=========================================== */

.hero-stats{

    margin-top:70px;

    display:flex;

    justify-content:center;

    gap:80px;

    flex-wrap:wrap;

}

.hero-stats h3{

    font-size:54px;

    color:var(--gold);

}

.hero-stats span{

    color:white;

    letter-spacing:2px;

    text-transform:uppercase;

}
/* ===========================================
Intro Section
=========================================== */

.intro-section{

    background:var(--cream);

}

.intro-section h2{

    font-size:64px;

    margin-bottom:30px;

}

.intro-section p{

    margin-bottom:25px;

}

.image-stack{

    position:relative;

    min-height:550px;

}

.main-image{

    width:90%;

    border-radius:20px;

    box-shadow:var(--shadow);

}

.secondary-image{

    position:absolute;

    width:45%;

    right:0;

    bottom:-40px;

    border:8px solid white;

    border-radius:18px;

    box-shadow:var(--shadow);

}

/* ===========================================
Statistics
=========================================== */

.stats-section{

    background:var(--green);

}

.stat-card{

    background:white;

    padding:60px 30px;

    text-align:center;

    border-radius:18px;

    transition:.35s;

    box-shadow:var(--shadow);

}

.stat-card:hover{

    transform:translateY(-10px);

}

.stat-card h1{

    font-size:72px;

    color:var(--green);

    margin-bottom:10px;

}

.stat-card p{

    text-transform:uppercase;

    letter-spacing:2px;

    font-weight:600;

    color:var(--gray);

}

/* ===========================================
Tournament Section
=========================================== */

.about-tournament{

    background:white;

}

.feature-box{

    background:var(--green);

    color:white;

    padding:45px;

    border-radius:20px;

    box-shadow:var(--shadow);

}

.feature-box h3{

    color:var(--gold);

    margin-bottom:30px;

    font-size:40px;

}

.feature-box ul{

    list-style:none;

    padding:0;

}

.feature-box li{

    padding:12px 0;

    border-bottom:1px solid rgba(255,255,255,.12);

}

/* ===========================================
Courses
=========================================== */

.courses-preview{

    background:#f4f1ea;

}

.course-card{

    background:white;

    border-radius:20px;

    overflow:hidden;

    transition:.4s;

    box-shadow:var(--shadow);

}

.course-card:hover{

    transform:translateY(-12px);

}

.course-card img{

    width:100%;

    height:340px;

    object-fit:cover;

}

.course-content{

    padding:35px;

}

.course-content h3{

    font-size:40px;

}

.course-content p{

    color:var(--gray);

}

/* ===========================================
Champions
=========================================== */

.champions-section{

    background:white;

}

.champions-card{

    background:linear-gradient(

        135deg,

        #0B3D2E,

        #134D3C

    );

    color:white;

    padding:70px;

    border-radius:30px;

    box-shadow:var(--shadow);

}

.champions-card h3{

    font-size:54px;

    color:var(--gold);

}

.champions-text{

    color:white;

    margin:35px 0;

}

/* ===========================================
Participants
=========================================== */

.players-preview{

    background:var(--cream);

}

.player-card{

    background:white;

    text-align:center;

    padding:35px;

    border-radius:18px;

    transition:.35s;

    box-shadow:var(--shadow);

}

.player-card:hover{

    transform:translateY(-10px);

}

.player-card img{

    width:180px;

    height:180px;

    object-fit:cover;

    border-radius:50%;

    border:6px solid var(--gold);

    margin-bottom:20px;

}

.player-card h5{

    font-size:28px;

}

/* ===========================================
Gallery
=========================================== */

.gallery-preview{

    background:white;

}

.gallery-grid{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:18px;

    padding:0 40px;

}

.gallery-grid img{

    width:100%;

    height:340px;

    object-fit:cover;

    border-radius:18px;

    transition:.35s;

    cursor:pointer;

}

.gallery-grid img:hover{

    transform:scale(1.04);

}

/* ===========================================
Countdown
=========================================== */

.countdown-section{

    background:var(--green);

    color:white;

}

.countdown-section h2{

    color:white;

    margin-bottom:60px;

}

.countdown-wrapper{

    display:flex;

    justify-content:center;

    gap:40px;

    flex-wrap:wrap;

}

.time-box{

    width:180px;

    padding:40px;

    border-radius:20px;

    background:white;

    color:black;

    box-shadow:var(--shadow);

}

.time-box h1{

    color:var(--green);

    font-size:72px;

}

.time-box span{

    letter-spacing:2px;

    text-transform:uppercase;

}
/* ===========================================
Footer
=========================================== */

footer{

    background:#081f17;

    color:white;

    padding:90px 0 50px;

    text-align:center;

}

footer h2{

    font-size:58px;

    color:var(--gold);

    margin-bottom:15px;

}

footer p{

    color:rgba(255,255,255,.75);

    margin-bottom:10px;

}

footer hr{

    width:120px;

    margin:40px auto;

    border:1px solid rgba(255,255,255,.15);

}

.footer-links{

    display:flex;

    justify-content:center;

    gap:35px;

    flex-wrap:wrap;

    margin-bottom:40px;

}

.footer-links a{

    color:white;

    text-decoration:none;

    transition:.3s;

    letter-spacing:1px;

}

.footer-links a:hover{

    color:var(--gold);

}

.copyright{

    opacity:.6;

    font-size:15px;

}

/* ===========================================
Scroll Indicator
=========================================== */

.scroll-indicator{

    position:absolute;

    bottom:35px;

    left:50%;

    transform:translateX(-50%);

    color:white;

    font-size:32px;

    animation:bounce 2s infinite;

    z-index:10;

}

@keyframes bounce{

    0%{transform:translate(-50%,0);}
    50%{transform:translate(-50%,12px);}
    100%{transform:translate(-50%,0);}

}

/* ===========================================
Fade Animations
=========================================== */

.fade-up{

    opacity:0;

    transform:translateY(60px);

    transition:1s ease;

}

.fade-up.active{

    opacity:1;

    transform:translateY(0);

}

.fade-in{

    opacity:0;

    transition:1s;

}

.fade-in.active{

    opacity:1;

}

/* ===========================================
Card Hover Effects
=========================================== */

.course-card,
.player-card,
.stat-card,
.time-box,
.champions-card{

    transition:.35s ease;

}

.course-card:hover,
.player-card:hover,
.stat-card:hover,
.time-box:hover{

    transform:translateY(-10px);

    box-shadow:0 25px 60px rgba(0,0,0,.18);

}

/* ===========================================
Buttons
=========================================== */

.btn{

    transition:.35s;

    font-weight:600;

    letter-spacing:1px;

}

.btn:hover{

    transform:translateY(-3px);

}

/* ===========================================
Images
=========================================== */

img{

    max-width:100%;

    display:block;

}

.rounded{

    border-radius:18px !important;

}

.shadow-lg{

    box-shadow:0 20px 50px rgba(0,0,0,.18)!important;

}

/* ===========================================
Responsive
=========================================== */

@media(max-width:1200px){

.hero-content h1{

    font-size:84px;

}

.gallery-grid{

    grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:992px){

.hero{

    text-align:center;

}

.hero-content h1{

    font-size:68px;

}

.hero-content h2{

    font-size:34px;

}

.hero-stats{

    gap:35px;

}

.intro-section h2{

    font-size:48px;

}

.main-image{

    width:100%;

}

.secondary-image{

    display:none;

}

.champions-card{

    padding:40px;

}

.player-card img{

    width:140px;

    height:140px;

}

}

@media(max-width:768px){

.hero{

    height:90vh;

}

.hero-content h1{

    font-size:54px;

}

.hero-content h2{

    font-size:28px;

}

.subtitle{

    font-size:18px;

}

.hero-buttons{

    flex-direction:column;

    align-items:center;

}

.hero-stats{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:25px;

}

.gallery-grid{

    grid-template-columns:1fr;

    padding:0 20px;

}

.time-box{

    width:140px;

    padding:25px;

}

.time-box h1{

    font-size:48px;

}

footer h2{

    font-size:42px;

}

.footer-links{

    flex-direction:column;

    gap:18px;

}

}

@media(max-width:576px){

.hero-content h1{

    font-size:42px;

}

.hero-content h2{

    font-size:24px;

}

.navbar-brand{

    font-size:24px;

}

.logo{

    width:38px;

}

.hero-stats{

    grid-template-columns:1fr;

}

section{

    padding:80px 0;

}

.player-card{

    padding:20px;

}

.player-card img{

    width:120px;

    height:120px;

}

}

/* ===========================================
Utilities
=========================================== */

.text-gold{

    color:var(--gold);

}

.bg-green{

    background:var(--green);

}

.bg-cream{

    background:var(--cream);

}

.shadow-custom{

    box-shadow:var(--shadow);

}

.round-xl{

    border-radius:24px;

}
